{
  "name": "family-gift-registry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "concurrently --kill-others \"npm start\" \"npm run dev:api\"",
    "dev:api": "node scripts/development.mjs",
    "dev:all": "npm run dev",
    "build": "vite build",
    "test": "vitest run",
    "db:upgrade": "node scripts/database.mjs upgrade",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:current": "node scripts/database.mjs current",
    "db:check": "node scripts/database.mjs check",
    "db:heads": "node scripts/database.mjs heads"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "bootstrap": "^5.3.3",
    "react-bootstrap": "^2.10.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
