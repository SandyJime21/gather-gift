APP_ENV=development
SESSION_TYPE=cachelib
SECRET_KEY=replace-with-a-long-random-development-secret
DATABASE_URL=mysql+pymysql://gift_registry:gift_registry_dev@127.0.0.1:3306/family_gifts?charset=utf8mb4
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=
MYSQL_PASSWORD=gift_registry_dev
MYSQL_ROOT_PASSWORD=local_root_dev
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=instance\uploads
MAX_CONTENT_LENGTH=8388608

# Public contact address used to prepare support and advertising email inquiries.
VITE_CONTACT_EMAIL=

# Backend only. Set these on the Render API service, never with a VITE_ prefix.
SERPAPI_API_KEY=
# Optional later: approved Amazon US Associates tracking ID, not an API key.
AMAZON_ASSOCIATE_TAG=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=

# Render production uses verified MySQL TLS. Optional custom CA secret-file path.
DATABASE_SSL_CA=
# Production requires HTTPS origin, a 32+ character random SECRET_KEY, managed
# MySQL (including sessions/rate limits). Email features need SMTP with STARTTLS.

# Backend advertising: Leave blank until Stripe is configured. Never prefix with VITE_.
STRIPE_SECRET_KEY=

# Backend advertising: Leave blank until Stripe is configured. Never prefix with VITE_.
STRIPE_WEBHOOK_SECRET=

# Backend advertising: USD cents per scheduled day per placement. Set your price before approving ads.
ADS_DAILY_RATE_CENTS=

# Optional future store affiliate rules; exact store domains only. See README.
STORE_AFFILIATE_RULES={}

# eBay server-only Application Keys (App ID and Cert ID).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
# Optional eBay Partner Network campaign ID; separate from developer keys.
EBAY_AFFILIATE_CAMPAIGN_ID=

# Optional commerce adapters, server-only. Approval and provider controls are separate.
PERMITTED_METADATA_DOMAINS=
SOVRN_COMMERCE_API_KEY=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
CJ_API_TOKEN=
CJ_COMPANY_ID=
CJ_WEBSITE_ID=
RAKUTEN_API_TOKEN=
SKIMLINKS_CLIENT_ID=
SKIMLINKS_CLIENT_SECRET=
